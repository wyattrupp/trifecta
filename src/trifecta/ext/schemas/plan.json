{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "authors", "created"],
  "properties": {
    "status": {"enum": ["draft", "active", "done", "abandoned"]},
    "authors": {"type": "array", "items": {"type": "string", "not": {"pattern": "[\r\n]"}}, "minItems": 1},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "not": {"pattern": "[\r\n]"}}
  }
}
