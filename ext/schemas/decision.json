{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MADR frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "date", "decision-makers"],
  "properties": {
    "status": {"enum": ["proposed", "accepted", "rejected", "deprecated", "superseded"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "decision-makers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "consulted": {"type": "array", "items": {"type": "string"}},
    "informed": {"type": "array", "items": {"type": "string"}}
  }
}
